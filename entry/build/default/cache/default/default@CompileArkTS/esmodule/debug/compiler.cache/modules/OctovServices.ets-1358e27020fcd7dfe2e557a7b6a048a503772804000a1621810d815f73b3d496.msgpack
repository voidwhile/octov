const ALIYUN_SCOPES = ['user:base', 'file:all:read', 'file:all:write'];
function formatFileSize(bytes) {
    const units = ['B', 'KB', 'MB', 'GB', 'TB'];
    let value = bytes;
    let index = 0;
    while (value >= 1024 && index < units.length - 1) {
        value = value / 1024;
        index += 1;
    }
    return value.toFixed(1) + ' ' + units[index];
}
