    }
    seed() {
        const now = new Date().toISOString();
        this.storages = [
            {
                id: 'local-main',
                type: 'local',
                name: 'Local Media',
                createdAt: now,
                userName: 'This Device'
            },
            {
                id: 'aliyun-main',
                type: 'aliyundrive',
                name: 'Aliyun Drive',
                createdAt: now,
                userName: 'Not Authorized'
            }
        ];
        this.sources = [
            {
                id: 'source-local-demo',
                name: 'Movies Demo',
                storageId: 'local-main',
                storageType: 'local',
                storageName: 'Local Media',
                path: '/storage/Users/Movies',
                createdAt: now
            },
            {
                id: 'source-aliyun-demo',
                name: 'Cloud Favorites',
                storageId: 'aliyun-main',
                storageType: 'aliyundrive',
                storageName: 'Aliyun Drive',
                path: 'root',
                createdAt: now
            }
        ];
        this.mediaLibrary = createSeedLibrary();
        this.playbackSession = createDefaultPlayback();
        this.applyAliyunCredentialsToStatus();
        this.aliyunQrSession = createDefaultAliyunQrSession();
    }
    applyAliyunCredentialsToStatus() {
        this.aliyunStatus.clientId = this.settings.aliyunClientId;
        this.aliyunStatus.clientSecretConfigured = this.settings.aliyunClientSecret.length > 0;
        if (!this.aliyunStatus.isLoggedIn) {
            this.aliyunStatus.authorizationSource = this.settings.aliyunClientId.length > 0 ? '.env' : 'not_configured';
        }
    }
    addSourceIfNeeded(source) {
        let exists = false;
        let index = 0;
        while (index < this.sources.length) {
            const current = this.sources[index];
            if (current.path === source.path && current.storageType === source.storageType) {
                exists = true;
                break;
            }
            index += 1;
        }
        if (!exists) {
            this.sources.push(source);
        }
    }
    buildContinueWatching(items) {
        const list = [];
        let index = 0;
        while (index < items.length) {
            const item = items[index];
            if (item.progress !== undefined && item.progress.percentage > 0 && item.progress.percentage < 95) {
                list.push(cloneMediaItem(item));
            }
            index += 1;
        }
        list.sort((left, right) => {
            const leftTime = left.progress === undefined ? 0 : new Date(left.progress.lastPlayed).getTime();
            const rightTime = right.progress === undefined ? 0 : new Date(right.progress.lastPlayed).getTime();
            if (leftTime > rightTime) {
                return -1;
            }
            if (leftTime < rightTime) {
                return 1;
            }
            return 0;
        });
        return list;
    }
    buildRecentlyAdded(items) {
        const list = cloneMediaList(items);
        list.sort(compareDate);
        if (list.length > 18) {
            return list.slice(0, 18);
        }
        return list;
    }
    snapshot() {
        const library = cloneMediaList(this.mediaLibrary);
        return {
            library: library,
            continueWatching: this.buildContinueWatching(library),
            recentlyAdded: this.buildRecentlyAdded(library),
            storages: cloneStorageList(this.storages),
            sources: cloneSourceList(this.sources),
            settings: cloneSettings(this.settings),
            aliyunStatus: cloneAliyunStatus(this.aliyunStatus),
            aliyunQrSession: cloneAliyunQrSession(this.aliyunQrSession),
            playback: clonePlayback(this.playbackSession)
        };
    }
    syncPlaybackToLibrary() {
        if (this.currentPlaybackMediaId.length === 0) {
            return;
        }
        const item = this.findMediaItemById(this.currentPlaybackMediaId);
        if (item === undefined || this.playbackSession.duration <= 0) {
            return;
        }
        item.progress = {
            currentTime: this.playbackSession.currentTime,
            totalDuration: this.playbackSession.duration,
            percentage: this.playbackSession.progress,
            lastPlayed: new Date().toISOString()
        };
        if (this.playbackSession.status === 'idle' && this.playbackSession.progress === 0) {
            this.currentPlaybackMediaId = '';
        }
    }
    async syncCloudPlaybackCursor() {
        if (this.aliyunToken === undefined ||
            !this.aliyunStatus.isLoggedIn ||
            this.playbackSession.cloudFileId === undefined ||
            this.playbackSession.cloudFileId.length === 0 ||
            this.playbackSession.currentTime <= 0) {
            return;
        }
        try {
            await this.aliyunAuthService.updatePlayCursor(this.aliyunToken, this.playbackSession.cloudFileId, Math.floor(this.playbackSession.currentTime));
        }
        catch (_error) {
        }
    }
    findMediaItemById(mediaId) {
        let index = 0;
        while (index < this.mediaLibrary.length) {
            if (this.mediaLibrary[index].id === mediaId) {
                return this.mediaLibrary[index];
            }
            index += 1;
        }
        return undefined;
    }
    findSourceById(sourceId) {
        let index = 0;
        while (index < this.sources.length) {
            if (this.sources[index].id === sourceId) {
                return this.sources[index];
            }
            index += 1;
        }
        return undefined;
    }
    browseLocalSource(source) {
        const entries = [];
        let index = 0;
        while (index < this.mediaLibrary.length) {
            const item = this.mediaLibrary[index];
            if (item.sourceId === source.id) {
                entries.push({
                    id: 'local-entry-' + item.id,
                    name: item.title,
                    type: item.type === 'music' ? 'audio' : 'video',
                    storageType: source.storageType,
                    sourceId: source.id,
                    parentId: source.id,
                    path: item.filePath === undefined ? source.path : item.filePath,
                    updatedAt: item.dateAdded,
                    duration: item.duration,
                    mediaId: item.id,
                    filePath: item.filePath,
                    thumbnail: item.poster,
                    sizeLabel: item.fileExt === undefined ? '' : item.fileExt.toUpperCase()
                });
            }
            index += 1;
        }
        return {
            sourceId: source.id,
            sourceName: source.name,
            storageType: source.storageType,
            currentFolderId: source.id,
            breadcrumbs: [
                { id: source.id, name: source.name }
            ],
            entries: entries,
            nextMarker: ''
        };
    }
    async browseAliyunSource(source, folderId) {
        if (this.aliyunToken !== undefined && this.aliyunStatus.isLoggedIn) {
            try {
                const remoteFolderId = folderId === undefined || folderId.length === 0 ? source.path : folderId;
                const payload = await this.aliyunAuthService.listFiles(this.aliyunToken, remoteFolderId);
                return this.buildAliyunRemoteSnapshot(source, remoteFolderId, payload.items === undefined ? [] : payload.items, payload.next_marker);
            }
            catch (_error) {
            }
        }
        return this.buildAliyunMockSnapshot(source, folderId);
    }
    mapAliyunEntries(source, folderId, remoteItems) {
        const entries = [];
        let index = 0;
        while (index < remoteItems.length) {
            const item = remoteItems[index];
            entries.push({
                id: item.file_id,
                name: item.name,
                type: item.type === 'folder' ? 'folder' : item.category === 'video' ? 'video' : item.category === 'audio' ? 'audio' : 'other',
                storageType: 'aliyundrive',
                sourceId: source.id,
                parentId: folderId,
                path: item.file_id,
                updatedAt: item.updated_at === undefined ? new Date().toISOString() : item.updated_at,
                duration: item.video_media_metadata === undefined ? undefined : item.video_media_metadata.duration,
                sizeLabel: item.size === undefined ? undefined : formatFileSize(item.size),
                cloudFileId: item.file_id,
                thumbnail: item.thumbnail
            });
            index += 1;
        }
        return entries;
    }
    mapAliyunPlaybackQualities(payload) {
        const result = [];
        const tasks = payload.video_preview_play_info === undefined || payload.video_preview_play_info.live_transcoding_task_list === undefined
            ? []
            : payload.video_preview_play_info.live_transcoding_task_list;
        let index = 0;
        while (index < tasks.length) {
            const task = tasks[index];
            if (task.template_id !== undefined &&
                task.status === 'finished' &&
                task.url !== undefined &&
                task.url.length > 0) {
                result.push({
                    id: task.template_id,
                    label: this.qualityLabel(task.template_id),
                    url: task.url,
                    format: 'hls'
                });
            }
            index += 1;
        }
        result.sort((left, right) => left.label.localeCompare(right.label));
        return result;
    }
    qualityLabel(templateId) {
        if (templateId === 'LD') {
            return '360P';
        }
        if (templateId === 'SD') {
            return '540P';
        }
        if (templateId === 'HD') {
            return '720P';
        }
        if (templateId === 'FHD') {
            return '1080P';
        }
        if (templateId === 'QHD') {
            return '2K';
        }
        if (templateId === '4K') {
            return '4K';
        }
        return templateId;
    }
    buildCloudPlaybackQueue(remoteItems) {
        const result = [];
        let index = 0;
        while (index < remoteItems.length) {
            const item = remoteItems[index];
            if (item.type !== 'folder' && item.category === 'video') {
                result.push({
                    id: item.file_id,
                    title: item.name
                });
            }
            index += 1;
        }
        result.sort((left, right) => left.title.localeCompare(right.title));
        return result;
    }
    findPlaybackQueueIndex(items, cloudFileId) {
        let index = 0;
        while (index < items.length) {
            if (items[index].id === cloudFileId) {
                return index;
            }
            index += 1;
        }
        return -1;
    }
    buildAliyunRemoteSnapshot(source, folderId, remoteItems, nextMarker) {
        const entries = this.mapAliyunEntries(source, folderId, remoteItems);
        const currentName = folderId === source.path ? source.name : 'Cloud Folder';
        return {
            sourceId: source.id,
            sourceName: source.name,
            storageType: source.storageType,
            currentFolderId: folderId,
            breadcrumbs: [
                { id: source.path, name: source.name },
                { id: folderId, name: currentName }
            ],
            entries: entries,
            nextMarker: nextMarker === undefined ? '' : nextMarker
        };
    }
    buildAliyunMockSnapshot(source, folderId) {
        const currentFolderId = folderId === undefined || folderId.length === 0 ? source.path : folderId;
        const entries = [];
        const breadcrumbs = [
            { id: source.path, name: source.name }
        ];
        let index = 0;
        while (index < this.mediaLibrary.length) {
            const item = this.mediaLibrary[index];
            if (item.sourceId === source.id) {
                if (item.type === 'tvshow') {
                    const showFolderId = 'cloud-show-' + item.id;
                    if (currentFolderId === source.path) {
                        entries.push({
                            id: showFolderId,
                            name: item.title,
                            type: 'folder',
                            storageType: 'aliyundrive',
                            sourceId: source.id,
                            parentId: source.path,
                            path: showFolderId,
                            updatedAt: item.dateAdded,
                            thumbnail: item.poster
                        });
                    }
                    else if (currentFolderId === showFolderId) {
                        breadcrumbs.push({ id: showFolderId, name: item.title });
                        let seasonIndex = 0;
                        while (seasonIndex < item.seasons.length) {
                            const season = item.seasons[seasonIndex];
                            const seasonFolderId = showFolderId + '-season-' + season.seasonNumber.toString();
                            entries.push({
                                id: seasonFolderId,
                                name: season.name,
                                type: 'folder',
                                storageType: 'aliyundrive',
                                sourceId: source.id,
                                parentId: showFolderId,
                                path: seasonFolderId,
                                updatedAt: item.dateAdded,
                                thumbnail: item.poster
                            });
                            seasonIndex += 1;
                        }
                    }
                    else {
                        let seasonIndex = 0;
                        while (seasonIndex < item.seasons.length) {
                            const season = item.seasons[seasonIndex];
                            const seasonFolderId = showFolderId + '-season-' + season.seasonNumber.toString();
                            if (currentFolderId === seasonFolderId) {
                                breadcrumbs.push({ id: showFolderId, name: item.title });
                                breadcrumbs.push({ id: seasonFolderId, name: season.name });
                                let episodeIndex = 0;
                                while (episodeIndex < season.episodes.length) {
                                    const episode = season.episodes[episodeIndex];
                                    entries.push({
                                        id: seasonFolderId + '-episode-' + episode.episode.toString(),
                                        name: 'E' + episode.episode.toString() + ' ' + episode.name,
                                        type: 'video',
                                        storageType: 'aliyundrive',
                                        sourceId: source.id,
                                        parentId: seasonFolderId,
                                        path: episode.cloudFileId === undefined ? item.id : episode.cloudFileId,
                                        updatedAt: item.dateAdded,
                                        duration: episode.duration,
                                        mediaId: item.id,
                                        cloudFileId: episode.cloudFileId === undefined ? item.cloudFileId : episode.cloudFileId,
                                        thumbnail: item.poster
                                    });
                                    episodeIndex += 1;
                                }
                            }
                            seasonIndex += 1;
                        }
                    }
                }
                else if (currentFolderId === source.path) {
                    entries.push({
                        id: 'cloud-item-' + item.id,
                        name: item.title,
                        type: item.type === 'music' ? 'audio' : 'video',
                        storageType: 'aliyundrive',
                        sourceId: source.id,
                        parentId: source.path,
                        path: item.cloudFileId === undefined ? item.id : item.cloudFileId,
                        updatedAt: item.dateAdded,
                        duration: item.duration,
                        mediaId: item.id,
                        cloudFileId: item.cloudFileId,
                        thumbnail: item.poster,
                        sizeLabel: item.fileExt === undefined ? undefined : item.fileExt.toUpperCase()
                    });
                }
            }
            index += 1;
        }
        return {
            sourceId: source.id,
            sourceName: source.name,
            storageType: source.storageType,
            currentFolderId: currentFolderId,
            breadcrumbs: breadcrumbs,
            entries: entries,
            nextMarker: ''
        };
    }
}
