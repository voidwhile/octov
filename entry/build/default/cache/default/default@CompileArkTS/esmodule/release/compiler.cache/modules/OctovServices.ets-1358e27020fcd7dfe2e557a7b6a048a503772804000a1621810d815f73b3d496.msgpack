}
function appendProgress(base, percentages) {
    const items = [];
    let index = 0;
    while (index < base.length) {
        const item = cloneMediaItem(base[index]);
        if (index < percentages.length && item.type !== 'music') {
            item.progress = {
                currentTime: percentages[index] * 10,
                totalDuration: 3600,
                percentage: percentages[index],
                lastPlayed: new Date(Date.now() - index * 86400000).toISOString()
            };
        }
        items.push(item);
        index += 1;
    }
    return items;
}
function compareDate(left, right) {
    const leftValue = new Date(left.dateAdded).getTime();
    const rightValue = new Date(right.dateAdded).getTime();
    if (leftValue > rightValue) {
        return -1;
    }
    if (leftValue < rightValue) {
        return 1;
    }
    return 0;
}
